\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{study-note-style}[2026/09/18 study-note-style-v1]

\RequirePackage{iftex}
\ifXeTeX\else
  \PackageError{study-note-style}{XeLaTeX is required}{Compile the study guide with XeLaTeX.}
\fi

\RequirePackage{fontspec}
\RequirePackage{xeCJK}
\setmainfont{Times New Roman}
\setsansfont{Times New Roman}
\setmonofont{Latin Modern Mono}
% 正文用楷体，加粗改用宋体真 Bold 字重：FandolKai 只有 Regular，映射到黑体会让
% 强调处与正文风格割裂。FandolSong-Bold 随 TeX Live 分发，不引入额外字体依赖。
\setCJKmainfont{FandolKai-Regular.otf}[
  BoldFont=FandolSong-Bold.otf,
  ItalicFont=FandolKai-Regular.otf,
  BoldItalicFont=FandolSong-Bold.otf
]
\setCJKsansfont{FandolHei-Regular.otf}[BoldFont=FandolHei-Bold.otf]
\setCJKmonofont{FandolFang-Regular.otf}

\RequirePackage{geometry}
\geometry{left=2cm,right=2cm,top=2cm,bottom=2cm}

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{mathtools}
\RequirePackage{unicode-math}
\setmathfont{XITS Math}

\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{colortbl}
\RequirePackage{pifont}
\RequirePackage[most]{tcolorbox}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,intersections,positioning,shapes.geometric,calc,backgrounds,fit,matrix}
\RequirePackage{hyperref}

\definecolor{starred}{RGB}{180,30,30}
\definecolor{important}{RGB}{200,120,0}
\definecolor{know}{RGB}{100,100,100}
\definecolor{termcolor}{RGB}{0,60,120}
\definecolor{sectioncolor}{RGB}{0,80,60}
\definecolor{boxbg}{RGB}{252,250,242}
\definecolor{formulabg}{RGB}{245,245,255}
\definecolor{boxborder}{RGB}{0,80,60}

\hypersetup{
  unicode=true,
  hidelinks,
  pdfborder={0 0 0}
}
\urlstyle{same}

\titleformat{\section}{\LARGE\bfseries\color{sectioncolor}}{}{0em}{}
\titleformat{\subsection}{\large\bfseries\color{sectioncolor!80!black}}{}{0em}{}
\titlespacing{\section}{0pt}{8pt}{4pt}
\titlespacing{\subsection}{0pt}{6pt}{2pt}

\setlist{nosep,leftmargin=*,itemsep=0pt,parsep=0pt}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\renewcommand{\baselinestretch}{1.15}

\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0pt}

\newcommand{\StudyNoteStyleVersion}{study-note-style-v1}
\newcommand{\StudyStar}{\ding{72}}
\newcommand{\PriorityMust}{\textcolor{starred}{\StudyStar\StudyStar\StudyStar}}
\newcommand{\PriorityImportant}{\textcolor{important}{\StudyStar\StudyStar}}
\newcommand{\PriorityKnow}{\textcolor{know}{\StudyStar}}
\newcommand{\StudyTerm}[3]{#1\enspace\textbf{\color{termcolor}#2}：#3\par}

\tcbset{
  studybase/.style={
    enhanced,
    breakable,
    arc=0pt,
    outer arc=0pt,
    boxrule=0.45pt,
    left=2.5mm,
    right=2.5mm,
    top=1.5mm,
    bottom=1.5mm,
    before skip=0.3em,
    after skip=0.3em,
    fonttitle=\small\bfseries,
    fontupper=\small
  }
}

\newtcolorbox{definitionbox}[1][]{studybase,colback=boxbg,colframe=sectioncolor!30,#1}
\newtcolorbox{takeawaybox}[1][]{studybase,colback=boxbg,colframe=sectioncolor!40,#1}
\newtcolorbox{keypointbox}[1][]{studybase,colback=boxbg,colframe=sectioncolor!50,#1}
\newtcolorbox{formulabox}[1][]{studybase,colback=formulabg,colframe=sectioncolor!30,#1}
\newtcolorbox{proofbox}[1][]{studybase,colback=formulabg,colframe=sectioncolor!30,#1}
\newtcolorbox{mistakebox}[1][]{studybase,colback=boxbg,colframe=starred!45,#1}

% Reusable chapter-relationship map styles.  Edges must be source-grounded and
% use a short relationship label; these styles only control presentation.
\tikzset{
  study map base/.style={
    node distance=1.35cm and 1.9cm,
    every node/.style={font=\small},
  },
  study map node/.style={
    rectangle,
    draw,
    rounded corners=3pt,
    minimum width=2.7cm,
    minimum height=0.72cm,
    align=center,
    font=\small\bfseries,
    fill=white,
  },
  study map core/.style={study map node,draw=sectioncolor!75!black,thick,fill=sectioncolor!6},
  study map extension/.style={study map node,draw=important!75!black,thick,fill=important!5},
  study map remedy/.style={study map node,draw=starred!75!black,thick,fill=starred!4},
  study map foundation/.style={study map node,draw=know!75,fill=know!6},
  study map arrow/.style={->,>=Stealth,thick,sectioncolor!75!black},
  study map extension arrow/.style={->,>=Stealth,thick,important!80!black},
  study map remedy arrow/.style={->,>=Stealth,thick,starred!80!black},
  study map dashed arrow/.style={->,>=Stealth,thick,dashed,know!90!black},
  study map label/.style={font=\footnotesize\itshape,fill=white,inner sep=1.2pt,align=center},
}

\newcommand{\StudyMapLegend}{%
  {\footnotesize
    \textcolor{sectioncolor}{\rule{1.1ex}{1.1ex}} 核心路径\quad
    \textcolor{important}{\rule{1.1ex}{1.1ex}} 扩展与应用\quad
    \textcolor{starred}{\rule{1.1ex}{1.1ex}} 假设违背与补救\quad
    \textcolor{know}{\rule{1.1ex}{1.1ex}} 基础或背景}%
}

% Topic-separated, page-breakable formula summary used in the final review
% section.  Keep derivations in the body; each row is a retrieval cue only.
\newenvironment{FormulaSummaryTable}{%
  \small
  \setlength{\LTleft}{\fill}%
  \setlength{\LTright}{\fill}%
  \renewcommand{\arraystretch}{1.18}%
  \begin{longtable}{|>{\raggedright\arraybackslash}p{3.5cm}|>{\centering\arraybackslash}p{6cm}|>{\raggedright\arraybackslash}p{5.5cm}|}
  \hline
  \rowcolor{sectioncolor!8}
  \textbf{公式名称} & \textbf{公式} & \textbf{适用条件、用途或注意事项} \\
  \hline
  \endfirsthead
  \hline
  \rowcolor{sectioncolor!8}
  \textbf{公式名称} & \textbf{公式} & \textbf{适用条件、用途或注意事项} \\
  \hline
  \endhead
  \hline
  \multicolumn{3}{r}{\footnotesize\color{know}续下页} \\
  \endfoot
  \hline
  \endlastfoot
}{%
  \end{longtable}
}
\newcommand{\FormulaSummaryRow}[3]{#1 & #2 & #3 \\\hline}

\newcommand{\StudyDivider}{\vspace{2pt}\hrule\vspace{4pt}}
